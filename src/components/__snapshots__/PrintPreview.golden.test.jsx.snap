    </div>
    <div class="header-center">
      <h1>Collège Test</h1>
      <h2>12 rue des Écoles</h2>
      <p style="font-size:8pt;color:#6b7280;">+228 90 00 00 00 | contact@test.tg</p>
      <p class="devise">"L'excellence avant tout"</p>
    </div>
    <div class="header-right">
      <p><strong>Année scolaire</strong><br>2025-2026</p>
    </div>
  </div>

  <div class="bulletin-title">Bulletin Scolaire — Trimestre 1</div>

  <div class="student-box">
    <div class="student-fields">
      <div class="info-row"><div class="info-label">Nom</div><div class="info-value">MENSAH</div></div>
      <div class="info-row"><div class="info-label">Prénom</div><div class="info-value">Koffi</div></div>
      <div class="info-row"><div class="info-label">Classe</div><div class="info-value">6ème A</div></div>
      <div class="info-row"><div class="info-label">Effectif</div><div class="info-value">3 élèves</div></div>
      <div class="info-row"><div class="info-label">Rang</div><div class="info-value">1 / 2</div></div>
      <div class="info-row"><div class="info-label">Trimestre</div><div class="info-value">Trimestre 1</div></div>
      <div class="info-row"><div class="info-label">Date de naissance</div><div class="info-value">02/04/2013</div></div>
      <div class="info-row"><div class="info-label">Absences</div><div class="info-value" style="color:#374151;">2 abs. · 1 ret. · 2 injust.</div></div>
    </div>
    <div style="flex-shrink:0;"><img src="data:image/gif;base64," width="80" height="80" alt="QR" style="display:block;image-rendering:pixelated;"></div>
  </div>

  <table>
    <thead>
      <tr>
        <th class="left" style="min-width:95px;">Matière / Professeur</th>
        <th style="width:32px;">Coef.</th>
        <th style="width:40px;">Interro</th>
        <th style="width:40px;">Devoir</th>
        <th style="width:40px;">Compo</th>
        <th style="width:38px;">Bonus</th>
        <th style="width:48px;">Note /20</th>
        <th style="width:42px;">Moy.Cl.</th>
        <th style="width:48px;">Total pts</th>
        <th class="left">Appréciation</th>
        <th style="width:72px;">Signature</th>
      </tr>
    </thead>
    <tbody>
      
        <tr>
          <td class="subj-name">Maths &amp; <b>Physique</b><br>
            <span style="font-size:6.5pt;color:#94a3b8;font-weight:400;">M. Kodjo</span></td>
          <td class="center">4</td>
          <td class="center sub-note">14.00</td>
          <td class="center sub-note">15.00</td>
          <td class="center sub-note">16.00</td>
          <td class="center sub-note bonus">—</td>
          <td class="center" style="color:#059669;font-weight:800;font-size:10.5pt;">15.00</td>
          <td class="center" style="font-size:8pt;color:#6b7280;">12.00</td>
          <td class="center" style="color:#059669;font-size:8.5pt;">60.00</td>
          <td class="appreciate">Bon travail</td>
          <td class="center sig-cell"><div style="font-family:'Brush Script MT',cursive;font-size:9pt;color:#1e3a5f;">M. Kodjo</div>
           <div style="font-size:6pt;color:#2563eb;">✓ Signé</div></td>
        </tr>
        <tr>
          <td class="subj-name">Français<br>
            <span style="font-size:6.5pt;color:#94a3b8;font-weight:400;"></span></td>
          <td class="center">3</td>
          <td class="center sub-note">—</td>
          <td class="center sub-note">—</td>
          <td class="center sub-note">—</td>
          <td class="center sub-note bonus">—</td>
          <td class="center" style="color:#2563eb;font-weight:800;font-size:10.5pt;">11.00</td>
          <td class="center" style="font-size:8pt;color:#6b7280;">9.50</td>
          <td class="center" style="color:#2563eb;font-size:8.5pt;">33.00</td>
          <td class="appreciate"></td>
          <td class="center sig-cell"><span style="color:#d1d5db;font-size:7pt;">—</span></td>
        </tr>
      <tr style="background:#1e3a5f !important;">
        <td colspan="6" style="font-weight:bold;color:white;font-size:9pt;">TOTAL GÉNÉRAL</td>
        <td class="center" style="font-weight:bold;color:white;font-size:11pt;">13.29/20</td>
        <td class="center" style="color:white;font-size:8.5pt;">93.00</td>
        <td style="color:rgba(255,255,255,.7);font-size:7.5pt;">Coeff.: 7</td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="results-band">
    <div class="result-cell"><div class="result-label">Moy. générale</div><div class="result-value">13.29<span style="font-size:8pt;">/20</span></div></div>
