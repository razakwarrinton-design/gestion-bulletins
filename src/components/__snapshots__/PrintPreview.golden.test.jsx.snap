      <div class="student-fullname">Koffi MENSAH</div>
      <div class="student-class">Classe: <strong>6ème A</strong> &nbsp;·&nbsp; Effectif: <strong>3</strong> &nbsp;·&nbsp; Rang: <strong>1/2</strong> &nbsp;·&nbsp; Né(e) le: <strong>02/04/2013</strong></div>
    </div>
    <div class="avg-display">
      <div class="avg-num">13.29</div>
      <div class="avg-label">Moy. / 20</div>
    </div>
  </div>

  <div class="kpis">
    <div class="kpi"><div class="kpi-val">10.93</div><div class="kpi-lbl">Moy. classe</div></div>
    <div class="kpi"><div class="kpi-val">13.29</div><div class="kpi-lbl">Max classe</div></div>
    <div class="kpi"><div class="kpi-val">8.57</div><div class="kpi-lbl">Min classe</div></div>
    <div class="kpi"><div class="kpi-val">7</div><div class="kpi-lbl">Coeff. total</div></div>
    <div class="kpi"><div class="kpi-val">93.0</div><div class="kpi-lbl">Total pts</div></div>
    <div class="kpi" style="background:inherit;"><div class="kpi-val" style="color:#1e40af;">2</div><div class="kpi-lbl">Absences</div><div style="font-size:6pt;color:#94a3b8;">1 ret.</div></div>
  </div>

  <div class="body-grid">
    <div>
      <table>
