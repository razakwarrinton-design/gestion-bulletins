         <div style="font-size:7pt;color:#64748b;margin-top:3px;">Directeur — 15/01/2026</div>
         <div style="margin-top:4px;display:inline-block;background:#dbeafe;color:#1d4ed8;font-size:6pt;font-weight:700;padding:1px 6px;border-radius:20px;">✓ Signé numériquement</div>
        </div>
      </div>
    </div>
    
    <div style="border:1.5px solid #cbd5e1;border-radius:10px;padding:8px 10px;background:#f8fafc;min-height:80px;display:flex;flex-direction:column;justify-content:space-between;">
      <div style="font-size:7pt;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">Visa du Prof. Principal</div>
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <div style="text-align:center;">
          <div style="font-family:'Brush Script MT','Segoe Script',cursive;font-size:13pt;color:#1e3a5f;line-height:1.1;border-bottom:1.5px solid #94a3b8;padding-bottom:3px;min-width:110px;">M. Kodjo</div>
         <div style="font-size:7pt;color:#64748b;margin-top:3px;">Prof. Principal — 15/01/2026</div>
         <div style="margin-top:4px;display:inline-block;background:#dbeafe;color:#1d4ed8;font-size:6pt;font-weight:700;padding:1px 6px;border-radius:20px;">✓ Signé numériquement</div>
        </div>
      </div>
    </div>
    
    <div style="border:1.5px solid #cbd5e1;border-radius:10px;padding:8px 10px;background:#f8fafc;min-height:80px;display:flex;flex-direction:column;justify-content:space-between;">
