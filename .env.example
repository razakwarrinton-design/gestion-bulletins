# Configuration Supabase
# Allez sur https://supabase.com et créez un nouveau projet
# Ensuite, copier vos clés d'accès ici

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ensuite, renommez ce fichier en .env.local et remplissez vos vraies clés

# Pages légales (Confidentialité, Conditions d'utilisation) : coordonnées de l'éditeur du service
# VITE_LEGAL_OPERATOR=Nom de l'entreprise ou de la personne qui exploite le service
# VITE_LEGAL_ADDRESS=Adresse postale
# VITE_LEGAL_EMAIL=contact@exemple.com
# VITE_DATA_HOSTING=Supabase, région Europe (Francfort)
